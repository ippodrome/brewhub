# BREWHUB_HOST is the host you actually reach this box on — an IP like
# `192.168.0.10`, or a hostname. Caddy's internal CA issues a certificate for
# it up front (as an IP SAN when it's an address), so once that CA is trusted
# the browser stops complaining. Defaults to `localhost` when unset.
#
# Why `default_sni` is required, and why the old `tls internal { on_demand }`
# could never work over IP: on-demand issuance picks the certificate from the
# TLS handshake's SNI, but browsers do not send SNI when connecting to a bare
# IP address (RFC 6066 excludes IP literals). Without SNI, Caddy has no name
# to match the connection against and aborts the handshake outright — so
# trusting the CA alone never fixed it. `default_sni` supplies the name Caddy
# should assume when the client offers none. See DECISIONS.md ADR-024.
{
	default_sni {$BREWHUB_HOST:localhost}
}

https://{$BREWHUB_HOST:localhost}:8443 {
	tls internal

	handle /api/* {
		reverse_proxy backend:3000
	}

	handle /ws {
		reverse_proxy backend:3000
	}

	handle {
		root * /srv/frontend

		# Vite content-hashes everything under /assets, so those URLs can
		# never go stale and are safe to cache forever. Everything else —
		# index.html, sw.js, and every SPA route that gets rewritten to
		# index.html below — must revalidate, or a deploy leaves browsers
		# holding an index.html pointing at asset hashes the new build has
		# already deleted, which shows up as a blank page until a hard
		# refresh. Caddy sends no Cache-Control of its own, so without this
		# those responses fall to the browser's heuristic caching.
		#
		# The rule is written as "cache /assets, revalidate everything else"
		# rather than listing index.html explicitly on purpose: `header` runs
		# before `try_files` in Caddy's directive order, so a request for
		# /devices is still /devices when the matcher sees it, and a matcher
		# naming /index.html would never fire for a deep link.
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@revalidate not path /assets/*
		header @revalidate Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
