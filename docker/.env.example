JWT_SECRET=change-me-to-a-long-random-string

# Point at the bundled broker (see docker-compose.mosquitto.yml) or your own
# existing one. If using the bundled broker, MQTT_URL is set for you by
# docker-compose.mosquitto.yml — you only need MQTT_USERNAME/MQTT_PASSWORD
# here (create that user with `mosquitto_passwd -b mosquitto/passwd
# brewhub-backend <password>`, matching what you put below).
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=brewhub-backend
MQTT_PASSWORD=change-me

# Optional — only needed to trigger OTA firmware updates (see README
# "Firmware / flashing"). The LAN address devices reach Caddy at.
# PUBLIC_URL=https://192.168.1.50:8443

# Optional — pins the published images to specific versions instead of
# always tracking latest. Accepts anything the publish workflows tag: a
# released version (e.g. 0.3.0), or a commit's sha-xxxxxxx for exact pinning.
#
# Two variables, not one: the workflows have separate path filters, so a
# frontend-only commit produces a frontend sha- tag with no backend
# counterpart. Pinning both to the same value would fail to resolve.
# BREWHUB_IMAGE_TAG=latest
# BREWHUB_FRONTEND_TAG=latest
#
# In-app updates (docker-compose.updater.yml) REQUIRE both to be pinned to a
# release version, e.g. BREWHUB_IMAGE_TAG=1.0.0 — rollback needs to know the
# exact previous version. The updater rewrites these two lines itself.

# ---- In-app updates (optional, see docs/UPDATERING.md) ----
# COMPOSE_FILE=docker-compose.yml:docker-compose.updater.yml
# COMPOSE_PROJECT_NAME=brewhub          # must match `docker compose ls`
# BREWHUB_COMPOSE_DIR=/mnt/user/appdata/brewhub/docker   # absolute path of this dir
# UPDATER_SECRET=                       # openssl rand -hex 32
# BREWHUB_GITHUB_TOKEN=                 # only if the GitHub repo is private
# BREWHUB_UPDATER_TAG=1.0.0
# BREWHUB_KEEP_BACKUPS=5
# UPDATER_DRY_RUN=0
