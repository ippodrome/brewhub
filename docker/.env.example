JWT_SECRET=change-me-to-a-long-random-string

# Point at the bundled broker (see docker-compose.mosquitto.yml) or your own
# existing one. If using the bundled broker, MQTT_URL is set for you by
# docker-compose.mosquitto.yml — you only need MQTT_USERNAME/MQTT_PASSWORD
# here (create that user with `mosquitto_passwd -b mosquitto/passwd
# brewhub-backend <password>`, matching what you put below).
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=brewhub-backend
MQTT_PASSWORD=change-me

# Optional — only needed to trigger OTA firmware updates (see README
# "Firmware / flashing"). The LAN address devices reach Caddy at.
# PUBLIC_URL=https://192.168.1.50:8443

# Optional — pins the published backend image to a specific version instead
# of always tracking latest. Accepts anything docker/workflows/publish-
# backend-image.yml tags: a released version (e.g. 0.3.0), or a commit's
# sha-xxxxxxx for exact pinning.
# BREWHUB_IMAGE_TAG=latest
