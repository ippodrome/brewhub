#pragma once

// Copy this file to secrets.h (gitignored) and fill in real values.
// DEVICE_ID must exactly match the id used when adding this device via the
// BrewHub UI/API — Phase 1 pairing is manual, there's no auto-discovery yet.

constexpr const char* WIFI_SSID = "your-wifi-ssid";
constexpr const char* WIFI_PASSWORD = "your-wifi-password";

constexpr const char* MQTT_HOST = "192.168.1.10";
constexpr uint16_t MQTT_PORT = 1883;
constexpr const char* MQTT_USERNAME = "brewhub-backend";
constexpr const char* MQTT_PASSWORD = "change-me";

constexpr const char* DEVICE_ID = "fermenter-01";
constexpr const char* FIRMWARE_VERSION = "0.1.0";

// --- OTA hardening (optional, recommended) ---------------------------------
// Only OTA URLs starting with this prefix are accepted. Set it to the
// backend's PUBLIC_URL. If omitted, only https://<MQTT_HOST>:<port>/api/firmware/
// URLs are accepted.
// #define OTA_URL_PREFIX "https://192.168.1.10:8443"
//
// Caddy's internal root CA (docker volume caddy-data:
// /data/caddy/pki/authorities/local/root.crt). When set, the OTA download
// verifies the server certificate instead of using setInsecure().
// #define OTA_CA_CERT R"PEM(-----BEGIN CERTIFICATE-----
// ...
// -----END CERTIFICATE-----)PEM"
